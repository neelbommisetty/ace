# repo's, and "node_modules/" matches only real directories, not the symlink.
node_modules
dist/
*.tsbuildinfo
*.tgz

# Environment / secrets
.env
.ace/

# IDE
.cursor/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
